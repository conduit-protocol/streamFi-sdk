# Stellar secret key for signing transactions (sender).
# Required for creating streams and other mutating operations.
# Deliberately NOT NEXT_PUBLIC_-prefixed — this is read only inside Server
# Actions (lib/streams.ts), never bundled to the client. Do not add the
# NEXT_PUBLIC_ prefix to this variable; doing so would ship it to every browser.
STELLAR_SECRET=S...

# DripFactory contract ID for the chosen network.
# Required for all factory queries (list streams, stream count, resolve
# stream address). Get this from the StreamFi docs for your network.
# Not NEXT_PUBLIC_-prefixed — only read in Server Actions, never in the browser.
FACTORY_ADDRESS=C...

# Network to connect to: mainnet | testnet | local
NEXT_PUBLIC_NETWORK=testnet

# Address to query streams for (recipient or sender).
# Can also be typed directly in the UI.
NEXT_PUBLIC_ADDRESS=G...
